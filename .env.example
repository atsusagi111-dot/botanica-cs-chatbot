# ============================================================
# 環境変数の一覧（このファイルをコピーして .env を作成してください）
# 各変数をどこで使う/どこで取得するかは README.md に手順があります
# ============================================================

# --- Supabase（apps/widget, apps/admin, scripts/seed-faqs.mjs 共通） ---
# Supabaseダッシュボード > Project Settings > API で確認できます
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key は絶対にフロントエンドに含めない（seedスクリプト・Edge Functionのみで使用）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- apps/widget (Vite) 用（VITE_ プレフィックス必須） ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CHAT_FUNCTION_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1/chat

# --- apps/admin (Next.js) 用（NEXT_PUBLIC_ プレフィックス必須） ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- OpenAI API（唯一の有料要素） ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- supabase/functions/chat（Supabase Edge Function Secrets として設定） ---
# supabase secrets set コマンドで設定します（README参照）
# OPENAI_API_KEY, OPENAI_CHAT_MODEL, OPENAI_EMBEDDING_MODEL は上と共通
FAQ_MATCH_THRESHOLD=0.75
FAQ_MATCH_COUNT=4
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
